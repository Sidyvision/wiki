# Sources brutes en attente d'INGEST — JAMAIS versionnées
# (peuvent contenir des données personnelles + fichiers volumineux)
# Seule la structure de dossiers est conservée via les .gitkeep.
/raw/*
!/raw/assets/
/raw/assets/*
!/raw/assets/.gitkeep
# Configuration locale Obsidian (par appareil, jamais versionnée)
/.obsidian/
# État runtime du détecteur de nouvelles fiches R&D (cron studio, régénéré
# chaque jour — jamais versionné, atelier/rd/outillage/detecter-nouvelles-fiches-rd.sh)
/atelier/rd/outillage/.snapshots-rd/
# Corpus citations-ghazali/ (données brutes volumineuses, jamais versionnées)
citations-ghazali/
# Essai Graphify (atelier/rd/outillage/, 2026-08-31) — venv isolé (196M) et
# sorties régénérables, jamais versionnées tant que l'essai n'est pas statué
# (voir atelier/rd/outillage/spec-essai-graphify.md)
/atelier/rd/outillage/.graphify-venv/
/atelier/rd/outillage/graphify-out/

# Configuration MCP locale (chemins absolus, pas versionnés)
/.mcp.json

# Index lexical — artefact DÉRIVÉ, régénérable par
# `atelier/rd/outillage/index-lexical/generer-index-lexical.py`.
# Seul le JSON est exclu : 3,7 Mo réécrits intégralement à chaque régénération,
# lus par le serveur MCP **sur le serveur** — ils n'ont aucune raison de
# descendre sur l'iPad. Le condensé `.md`, lui, RESTE versionné : la
# consultation Obsidian est l'un des deux consommateurs déclarés du chantier
# (verdict Sidy à son ouverture), et l'exclure la supprimerait.
/atelier/rd/outillage/index-lexical/index-lexical.json
# Le condensé d'un seul tenant est SUPERSÉDÉ par `condense/`, éclaté par
# initiale (2026-09-09) : 28 fichiers de 200 Ko au plus, au lieu d'un de
# 1,2 Mo. Garder les deux doublerait le poids sans rien ajouter. Le monolithe
# reste régénérable par `--sortie-md`.
/atelier/rd/outillage/index-lexical/index-lexical.md

# Caches Python — produits par les epreuves qui importent un script d outillage.
__pycache__/
*.pyc

#!/usr/bin/env bash
# Pre-commit hook : hygiène Unicode (Commandement 15) sur les fichiers indexés.
# Installation : bash atelier/rd/outillage/hooks/installer-hooks.sh
# Incident d'origine : atelier/rd/incidents/2026-08-22_zero-width-joiner-contamination.md
#
# Aligné le 2026-09-15 (verdict Sidy) sur le hook pre-push et le CI. L'ancienne
# version filtrait les fichiers indexés sur `\.(md|yaml|yml|json)$` et les
# balayait avec sa propre expression : un `.py` porteur d'invisibles passait au
# commit. Ce hook appelle désormais l'instrument unique du Cmd 15 (OUT-16),
# `verifier-hygiene-unicode.py`, sur la liste EXPLICITE des fichiers indexés —
# tous formats texte (les binaires sont ignorés par l'instrument), registre
# d'exceptions déclarées honoré, seule la classe Cmd 15 bloquante. Un seul
# instrument pour les trois portes (commit, push, CI) : elles ne peuvent plus
# diverger de lui.
#
# Portée : le fichier tel qu'il est sur disque, comme la version précédente —
# non le seul contenu indexé (un fichier indexé puis retouché est lu dans son
# état courant). Le pre-push et le CI, eux, voient ce qui part réellement.

set -uo pipefail

RACINE="$(git rev-parse --show-toplevel)"
cd "$RACINE" || exit 1

INSTRUMENT="atelier/rd/outillage/verifier-hygiene-unicode.py"

# Fichiers indexés (ajoutés, copiés, modifiés), séparés par NUL : les noms à
# espaces ou accents passent intacts.
mapfile -d '' FICHIERS < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "${#FICHIERS[@]}" -eq 0 ]; then
    exit 0
fi

if [ ! -f "$INSTRUMENT" ]; then
    echo "  ✗ pre-commit : $INSTRUMENT introuvable — contrôle Cmd 15 NON exécuté, commit refusé"
    exit 1
fi

if ! python3 "$INSTRUMENT" --racine . "${FICHIERS[@]}"; then
    echo ""
    echo "════════════════════════════════════════════════════════════════════"
    echo "BLOCAGE PRE-COMMIT — Commandement 15 (hygiène Unicode)"
    echo "Nettoyage d'un texte (perl, JAMAIS sed — voir l'incident du 2026-08-22) :"
    echo "  perl -CSD -i -pe 's/[\\x{200B}\\x{200C}\\x{200D}\\x{FEFF}\\x{200E}\\x{200F}]//g' <fichier>"
    echo "Dans du code, désigner le caractère par son échappement \\uXXXX."
    echo "════════════════════════════════════════════════════════════════════"
    exit 1
fi

exit 0
